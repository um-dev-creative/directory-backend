# Placeholder values used ONLY while Spring AOT processes the application at native-image build time (Dockerfile.native). AOT loads
# bootstrap.yml, whose ${VARS} have no default, but it does not connect to anything and the values are not compiled into the executable:
# the real ones come from the environment / Vault / Config Server at runtime. Nothing here is a credential.
APP_CLIENT_ROLES=aot
APP_PORT=8197
APP_TOKEN_EXPIRATION=1000
APP_TOKEN_SECRET=aot-placeholder
AUTH_CLIENT_ID=aot
AUTH_CLIENT_SECRET=aot
AUTH_SERVER_URI=https://aot.invalid
AUTH_TOKEN_URI=https://aot.invalid/token
BACKBONE_CLIENT_ID=aot
BACKBONE_CLIENT_SECRET=aot
BACKBONE_GRANT_TYPE=password
BACKBONE_PASSWORD=aot
BACKBONE_SCOPE=aot
BACKBONE_USERNAME=aot
CNFS_PORT=8888
CNFS_URI=https://aot.invalid
LOGGING_TRACE_ENABLED=false
MERCURY_CLIENT_ID=aot
MERCURY_CLIENT_SECRET=aot
MERCURY_GRANT_TYPE=password
MERCURY_PASSWORD=aot
MERCURY_SCOPE=aot
MERCURY_USERNAME=aot
REDIS_PASSWORD=aot
REDIS_PORT=6379
REDIS_SSL_ENABLED=false
REDIS_TIMEOUT=1000
REDIS_URL=localhost
SPRING_BOOT_CLOUD_BOOTSTRAP_ENABLED=false
SPRING_BOOT_PROFILE_ACTIVE=aot
SPRING_CLOUD_CONFIG_LABEL=aot
SSL_KEYSTORE_LOCATION=directory-rest.jks
SSL_KEYSTORE_PASSWORD=aot
SSL_KEYSTORE_TYPE=JKS
SSL_TRUSTSTORE_LOCATION=umdc-truststore.jks
SSL_TRUSTSTORE_PASSWORD=aot
SSL_TRUSTSTORE_TYPE=PKCS12
VAULT_ENABLED=false
VAULT_SERVER_URI=https://aot.invalid
VAULT_TOKEN=aot
