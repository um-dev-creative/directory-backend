# Non-secret, per-environment bootstrap config for docker / local runs. Versioned on purpose (the .gitignore exempts config/*.env):
# nothing in this file is a credential. Passwords and VAULT_TOKEN live in secrets/local.env (git-ignored, see secrets/local.env.example).
# Same split as smartkin-backend, mercury and zerobound-rest.
#
# Leave unset anything that Vault or the Config Server provides: an environment variable wins over them and would shadow the real value.

APP_PORT=8197
SPRING_BOOT_PROFILE_ACTIVE=
SPRING_CLOUD_CONFIG_LABEL=
VAULT_ENABLED=true
# Set the Vault and Config Server addresses of your environment (names as in bootstrap.yml):
#VAULT_SERVER_URI=
#CNFS_URI=

# TLS bundle "directory-security". Names of the files inside certs/directory/ (git-ignored), which the jar carries on its classpath (pom.xml).
SSL_KEYSTORE_LOCATION=directory-rest.jks
SSL_KEYSTORE_TYPE=JKS
SSL_TRUSTSTORE_LOCATION=umdc-truststore.jks
SSL_TRUSTSTORE_TYPE=PKCS12
# Optional, with a scheme: read the stores from a path instead of the classpath (e.g. a mounted volume). They win over the names above.
#SSL_KEYSTORE_URL=file:certs/directory/directory-rest.jks
#SSL_TRUSTSTORE_URL=file:certs/directory/umdc-truststore.jks
